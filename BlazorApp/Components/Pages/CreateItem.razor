@page "/create_item"
@rendermode InteractiveServer
@inject IItemService ItemService
@inject NavigationManager Navigation

<h3>Create New Item</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="@itemDto" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Name (8 - 200 chars):</label>
        <InputText class="form-control" @bind-Value="itemDto.Name" />
        <ValidationMessage For="@(() => itemDto.Name)" />
    </div>

    <div class="mb-3">
        <label>Description (20 - 500 chars):</label>
        <InputTextArea class="form-control" @bind-Value="itemDto.Description" />
        <ValidationMessage For="@(() => itemDto.Description)" />
    </div>

    <div class="mb-3">
        <label>Price:</label>
        <InputNumber class="form-control" @bind-Value="itemDto.Price" />
        <ValidationMessage For="@(() => itemDto.Price)" />
    </div>

    <div class="mb-3">
        <label>Keyword:</label>
        <InputText class="form-control" @bind-Value="itemDto.Keyword" />
        <ValidationMessage For="@(() => itemDto.Keyword)" />
    </div>

    <div class="mb-3">
        <label>Pictures (Max 4, PNG/JPEG, up to 2048x2048):</label>
        <InputFile OnChange="LoadFiles" class="form-control" multiple accept=".png, .jpeg, .jpg" />
        <small class="text-muted">Selected files: @selectedFiles.Count / 4</small>
    </div>

    <button type="submit" class="btn btn-success" disabled="@isSubmitting">
        @if (isSubmitting)
        {
            <span>Saving...</span>
        }
        else
        {
            <span>Create Item</span>
        }
    </button>
</EditForm>

@code {
    private ItemDto itemDto = new();
    private List<IBrowserFile> selectedFiles = new();
    private string? errorMessage;
    private bool isSubmitting;

    private void LoadFiles(InputFileChangeEventArgs e)
    {
        selectedFiles = e.GetMultipleFiles(4).ToList();
    }

    private async Task HandleValidSubmit()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            await ItemService.CreateItemAsync(itemDto, selectedFiles);
            
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}