@page "/"
@inject IItemService ItemService
@inject NavigationManager Navigation

<div class="page-container">
    <div class="header-row">
        <h1 class="page-title">Catalogue</h1>
        <NavLink href="create_item" class="action-button btn btn-primary">
            Create Item Listing
        </NavLink>
    </div>

    <div class="main-card mb-4">
        <div class="search-box mb-2">
            <span>A search bar could go here</span>
        </div>

        <div class="tags-box">
            <span>Tags for filtering will go here</span>
        </div>
    </div>

    <div class="table-container">
        @if (isLoading)
        {
            <p>Loading items...</p>
        }
        else if (items == null || !items.Any())
        {
            <p>No items found.</p>
        }
        else
        {
            <div class="row">
                @foreach (var item in items)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card p-3 shadow-sm">
                            <h3>@item.Name</h3>
                            <p>@item.Description</p>
                            <p>
                                <strong>Price:</strong> 
                                @(item.Price.HasValue && item.Price.Value > 0 ? $"${item.Price.Value}" : "Free")
                            </p>
                            <p><strong>Keyword:</strong> <span class="badge bg-secondary">@item.Keyword</span></p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private IEnumerable<ItemDto> items = Enumerable.Empty<ItemDto>();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await ItemService.GetItemsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading items: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}